{
  "name": "@territorios/geo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared RFC 7946 WGS84 GeoJSON types, validation helpers, and the database CLI (migrations live in db/)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "dev": "tsc -b tsconfig.json --watch",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx src/db/cli.ts migrate"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
