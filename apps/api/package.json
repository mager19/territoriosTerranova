{
  "name": "@territorios/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify + TypeScript API service",
  "exports": {
    "./vercel": {
      "types": "./dist/vercel.d.ts",
      "default": "./dist/vercel.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/main.ts",
    "build": "tsc -b tsconfig.json",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local dist/main.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@territorios/geo": "workspace:*",
    "@vercel/functions": "^3.9.11",
    "fastify": "^5.12.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
