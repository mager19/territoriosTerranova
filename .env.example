# Territory Management — environment template
#
# Copy to .env (or .env.local for secrets) and adjust. Every variable
# documented here is read by application code. Defaults shown match
# docker-compose.yml, so a plain local setup needs no .env at all.

# PostgreSQL/PostGIS connection string used by the API health check.
DATABASE_URL=postgres://territorios:territorios@127.0.0.1:5432/territorios

# HTTP port the API listens on (default: 3000).
PORT=3000

# HTTP host the API binds to (default: 127.0.0.1).
HOST=127.0.0.1

# --- Admin sign-in (docs/admin-auth.md) -------------------------------------
# One or two administrator accounts. Emails are compared case-insensitively;
# passwords need at least 12 characters and are used verbatim. ADMIN_1_* is
# required when NODE_ENV=production (the API refuses to start otherwise);
# ADMIN_2_* is optional. Put the real values in .env.local (git-ignored)
# locally and in the Render dashboard in production — never in this file.
ADMIN_1_EMAIL=
ADMIN_1_PASSWORD=
ADMIN_2_EMAIL=
ADMIN_2_PASSWORD=

# Origin the admin web app is served from (scheme://host[:port], no path).
# Required (https) in production; defaults to http://localhost:5173 locally.
# State-changing admin requests from any other Origin are refused, and the
# session cookie is Secure unless this is a plain-http local origin.
ADMIN_APP_ORIGIN=

# Fastify trustProxy: "true", or the number of proxy hops in front of the
# API (e.g. the Vercel rewrite + Render's own proxy). Needed so the sign-in
# rate limit keys on the real client IP. Default: false (direct connections).
TRUST_PROXY=

# MapTiler API key for the admin and public web apps (Vite reads this
# repo-root file via envDir). Empty or unset → OSM raster fallback basemap.
# Keep the real key in .env.local (git-ignored), never in this file.
# See docs/map-references.md "Basemap".
VITE_MAPTILER_KEY=
