{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-chat",
  "small_model": "deepseek/deepseek-chat",
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git switch -c *": "allow",
      "git checkout -b *": "allow",
      "git push *": "deny",
      "git merge *": "deny",
      "git rebase *": "deny",
      "git cherry-pick *": "deny",
      "git switch main*": "deny",
      "git checkout main*": "deny",
      "git branch -d *": "deny",
      "git branch -D *": "deny",
      "git reset --hard*": "deny",
      "git clean *": "deny",
      "rm -rf *": "deny",
      "pnpm install": "allow",
      "pnpm test*": "allow",
      "pnpm typecheck*": "allow",
      "pnpm build*": "allow",
      "pnpm lint*": "allow",
      "pnpm db:*": "ask",
      "docker compose *": "ask",
      "curl *": "ask"
    },
    "webfetch": "allow"
  }
}
